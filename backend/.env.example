MONGODB_URI=mongodb://127.0.0.1:27017/hisham_islamic_center
JWT_SECRET=change-me-in-production-min-16-chars
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=hisham_auth
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Vercel (same project): optional — defaults to https://${VERCEL_URL} when unset
# CLIENT_URL=https://your-project.vercel.app

# Development seed script only (npm run seed -w backend)
SEED_ADMIN_EMAIL=admin@hisham.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_FULL_NAME=Development Admin
# Set to true to re-hash password for an existing admin (fixes plaintext/corrupt passwordHash in Compass)
SEED_ADMIN_RESET_PASSWORD=false
# Optional aliases for bootstrap:admin script
# ADMIN_EMAIL=admin@hisham.local
# ADMIN_PASSWORD=ChangeMe123!
# ADMIN_FULL_NAME=Development Admin
# ADMIN_RESET_PASSWORD=true

# Explicit dev admin create/update (npm run admin:bootstrap -w backend only)
# ADMIN_BOOTSTRAP_EMAIL=admin@gmail.com
# ADMIN_BOOTSTRAP_PASSWORD=your-secure-password
# ADMIN_BOOTSTRAP_NAME=Hisham Administrator
# Set to true to wipe and re-seed development collections
SEED_CLEAR=false

# Optional future integrations
SMS_API_KEY=
WHATSAPP_API_KEY=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
